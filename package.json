{
  "name": "openlist-attach",
  "version": "0.8.1",
  "description": "Upload attachments to OpenList and insert stable direct links into notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "openlist",
    "alist",
    "attachment",
    "upload"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "docx-preview": "^0.4.1",
    "pdfjs-dist": "^6.3.289",
    "pptx-preview": "^1.0.7",
    "xlsx": "^0.18.5"
  }
}
